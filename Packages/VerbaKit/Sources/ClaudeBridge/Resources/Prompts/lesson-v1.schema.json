{
  "type": "object",
  "properties": {
    "title": { "type": "string", "minLength": 1, "maxLength": 80 },
    "topic": { "type": "string", "minLength": 1, "maxLength": 40 },
    "explanation": { "type": "string", "minLength": 1, "maxLength": 3000 },
    "exercises": {
      "type": "array",
      "minItems": 4,
      "maxItems": 6,
      "items": {
        "type": "object",
        "properties": {
          "kind": { "type": "string", "enum": ["choice", "fillBlank", "reorder", "match"] },
          "prompt": { "type": "string", "minLength": 1, "maxLength": 500 },
          "explanation": { "type": "string", "maxLength": 1000 },
          "choices": {
            "type": "array",
            "minItems": 3,
            "maxItems": 4,
            "items": {
              "type": "object",
              "properties": {
                "text": { "type": "string", "minLength": 1, "maxLength": 200 },
                "isCorrect": { "type": "boolean" }
              },
              "required": ["text", "isCorrect"],
              "additionalProperties": false
            }
          },
          "answers": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1, "maxLength": 200 }
          },
          "tokens": {
            "type": "array",
            "minItems": 2,
            "items": { "type": "string", "minLength": 1, "maxLength": 200 }
          },
          "pairs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "left": { "type": "string", "minLength": 1, "maxLength": 200 },
                "right": { "type": "string", "minLength": 1, "maxLength": 200 }
              },
              "required": ["left", "right"],
              "additionalProperties": false
            }
          }
        },
        "required": ["kind", "prompt", "explanation"],
        "additionalProperties": false
      }
    }
  },
  "required": ["title", "topic", "explanation", "exercises"],
  "additionalProperties": false
}
